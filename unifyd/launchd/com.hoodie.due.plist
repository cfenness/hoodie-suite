<?xml version="1.0" encoding="UTF-8"?>
<!-- The 30-minute dispatcher tick (NRT-PLAN.md §3). TEMPLATE — install deliberately:
       cp unifyd/launchd/com.hoodie.due.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.hoodie.due.plist
     and UNLOAD the old fixed-schedule com.hoodie.sources job at the same time
     (launchctl unload ~/Library/LaunchAgents/com.hoodie.sources.plist) so the two
     schedulers don't race. Overlap within run_due itself is already a lock-file no-op. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.hoodie.due</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/chrisfennessey/Desktop/Desktop - Chris’s MacBook Pro/Projects/hoodie-suite/unifyd/run_due.sh</string>
  </array>
  <key>StartInterval</key><integer>1800</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/hoodie_due.log</string>
  <key>StandardErrorPath</key><string>/tmp/hoodie_due.log</string>
</dict>
</plist>
