<?xml version="1.0" encoding="UTF-8"?>
<!-- Daily data-health digest (07:30, after the 03:00 sources pass). TEMPLATE — install:
       cp unifyd/launchd/com.hoodie.health.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.hoodie.health.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.hoodie.health</string>
  <!-- bash -c form: launchd denies SPAWNING a job whose script argument is under ~/Desktop
       ("Operation not permitted", exit 126), but a bash started with -c reads/executes it fine. -->
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec bash "/Users/chrisfennessey/Desktop/Desktop - Chris’s MacBook Pro/Projects/hoodie-suite/unifyd/run_health_digest.sh"</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/tmp/health_digest.log</string>
  <key>StandardErrorPath</key><string>/tmp/health_digest.log</string>
  <key>RunAtLoad</key><false/>
</dict></plist>
